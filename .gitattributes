# Normalise line endings so the working copy and repo agree on Windows,
# macOS and Linux. Without this, Git rewrites every file's line endings on
# checkout and the diff becomes noisy.
* text=auto eol=lf

# Windows-only shell scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be line-ending translated
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary