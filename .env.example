# ─────────────────────────────────────────────────────────────
# HAJIPUR FOOD → THE TAJ — environment configuration
# Copy to `.env.local` for development. Never commit real values.
# Everything here is read on the SERVER only.
# ─────────────────────────────────────────────────────────────

# Canonical site origin. Used for canonical URLs, Open Graph, sitemap.xml,
# robots.txt and JSON-LD. No trailing slash.
# NOTE: this value is inlined at BUILD time. Set it before `npm run build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public email address for the restaurant, if one is supplied.
# Leave unset and the site hides the address rather than showing
# an unmonitored inbox.
NEXT_PUBLIC_ENQUIRY_EMAIL=