# ─────────────────────────────────────────────────────────────
# HAJIPUR FOOD — environment configuration
# Copy to `.env.local` for development. Never commit real values.
# Everything here is read on the SERVER only.
# ─────────────────────────────────────────────────────────────

# Canonical site origin. Used for canonical URLs, Open Graph, sitemap.xml,
# robots.txt and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public enquiry address shown in the footer and privacy policy.
# Leave unset to hide the address and route everything through the enquiry form.
NEXT_PUBLIC_ENQUIRY_EMAIL=

# ─── Lead delivery ────────────────────────────────────────────
# `webhook` = POST enquiries to LEAD_WEBHOOK_URL (recommended for production)
# `file`    = append to .data/enquiries.jsonl on the server
# If unset: webhook is used when LEAD_WEBHOOK_URL exists, otherwise file.
LEAD_DELIVERY=webhook

# Where enquiries are sent. Examples:
#   https://api.web3forms.com/submit  (needs an access_key in the payload)
#   https://hooks.zapier.com/hooks/catch/xxxx/xxxx
#   https://api.make.com/webhooks/... 
#   https://your-domain.com/api/leads (your own handler)
LEAD_WEBHOOK_URL=

# Optional shared secret sent as `Authorization: Bearer <token>`.
# Use it so only your endpoint accepts leads.
LEAD_WEBHOOK_BEARER_TOKEN=

# ─── Abuse protection ─────────────────────────────────────────
# Max enquiries allowed per client per window.
RATE_LIMIT_MAX=5
# Window length in milliseconds (default 15 minutes).
RATE_LIMIT_WINDOW_MS=900000